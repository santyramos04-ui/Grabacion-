<?xml version="1.0" encoding="utf-8"?>
<!-- Grabadora compartida: servicio en primer plano de cámara y micrófono. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="com.santy.grabacion.recorder.CameraService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- Pantalla invisible para iniciar la grabación desde el botón de Ajustes rápidos. -->
        <activity
            android:name="com.santy.grabacion.recorder.RecorderLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Botón de Ajustes rápidos: empezar o detener la grabación. -->
        <service
            android:name="com.santy.grabacion.recorder.RecorderTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_record"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
