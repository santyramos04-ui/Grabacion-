<resources>
    <style name="Theme.Owl" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#C08A4B</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <!--
      Tema del módulo principal (Colección), dirección "Etiqueta de colección". El vault conserva
      Theme.Owl. Letra: Atkinson Hyperlegible; nombres científicos en Source Serif 4 cursiva.
    -->
    <style name="Theme.Owl.Collection" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/owl_primary</item>
        <item name="colorOnPrimary">@color/owl_on_primary</item>
        <item name="colorPrimaryContainer">@color/owl_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/owl_on_primary_container</item>
        <item name="colorSecondary">@color/owl_secondary</item>
        <item name="colorOnSecondary">@color/owl_on_secondary</item>
        <item name="colorSecondaryContainer">@color/owl_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/owl_on_secondary_container</item>
        <item name="colorTertiary">@color/owl_tertiary</item>
        <item name="colorOnTertiary">@color/owl_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/owl_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/owl_on_tertiary_container</item>
        <item name="colorError">@color/owl_error</item>
        <item name="colorOnError">@color/owl_on_error</item>
        <item name="android:colorBackground">@color/owl_background</item>
        <item name="colorOnBackground">@color/owl_on_background</item>
        <item name="colorSurface">@color/owl_surface</item>
        <item name="colorOnSurface">@color/owl_on_surface</item>
        <item name="colorSurfaceVariant">@color/owl_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/owl_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/owl_label</item>
        <item name="colorSurfaceContainerLow">@color/owl_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/owl_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/owl_surface_container_high</item>
        <item name="colorOutline">@color/owl_outline</item>
        <item name="colorOutlineVariant">@color/owl_outline_variant</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Owl.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Owl.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Owl.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Owl.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Owl.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Owl.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Owl.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Owl.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Owl.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Owl.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Owl.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Owl.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Owl.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Owl.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Owl.LabelSmall</item>
        <item name="materialCardViewStyle">@style/Widget.Owl.Card</item>
        <item name="toolbarStyle">@style/Widget.Owl.Toolbar</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Owl.Small</item>
    </style>

    <style name="TextAppearance.Owl.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.Owl.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>

    <!-- Tarjeta general: superficie quieta, sin sombra. -->
    <style name="Widget.Owl.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">8dp</item>
    </style>

    <!--
      Etiqueta de espécimen: cartulina blanca con filete fino y esquinas casi rectas, como las
      etiquetas impresas de las colecciones. Es el único elemento con carácter propio.
    -->
    <style name="Widget.Owl.Label" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/owl_label</item>
        <item name="cardCornerRadius">3dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Owl.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?android:attr/colorBackground</item>
    </style>

    <style name="ShapeAppearance.Owl.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">6dp</item>
    </style>

    <!-- Nombre científico: cursiva con serif, como se escribe en taxonomía. -->
    <style name="TextAppearance.Owl.Binomial" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/source_serif_italic</item>
        <item name="android:fontFamily">@font/source_serif_italic</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Código de catálogo: negrita con cifras de ancho fijo para que los números se alineen. -->
    <style name="TextAppearance.Owl.Code" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Títulos de las tarjetas de estadísticas y secciones. -->
    <style name="TextAppearance.Owl.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Cifras grandes del resumen. -->
    <style name="TextAppearance.Owl.Metric" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="ShapeAppearance.Owl.Round" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Owl.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Nombre de la app: Roboto Black en mayúsculas. -->
    <style name="TextAppearance.Owl.Wordmark" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
</resources>
