<?xml version="1.0" encoding="utf-8"?>
<!-- Atkinson Hyperlegible (Braille Institute, SIL OFL 1.1): letra principal de la Colección. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/atkinson_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/atkinson_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/atkinson_italic"
        android:fontStyle="italic"
        android:fontWeight="400"
        app:font="@font/atkinson_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />
    <font
        android:font="@font/atkinson_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/atkinson_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
