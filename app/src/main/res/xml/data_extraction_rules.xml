<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: el estado del vault no viaja en respaldos ni al cambiar de teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vault_gate.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vault_gate.xml" />
    </device-transfer>
</data-extraction-rules>
